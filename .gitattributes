# --- Normalización (va PRIMERO) ---
* text=auto eol=lf

*.gd        text eol=lf
*.gdshader  text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.import    text eol=lf
*.uid       text eol=lf
*.cfg       text eol=lf
*.godot     text eol=lf
*.cs        text eol=lf diff=csharp

# --- LFS (tu bloque actual, y luego esto) ---
